# ============================================================
# 生产环境部署安全配置模板 (请勿在此填写真实密码并提交到 Git)
# ============================================================

# 1. 数据库连接串 (PostgreSQL)
# 生产部署时，请在云平台（如 Vercel, Railway, Supabase, Neon）的环境变量设置中填写
# 示例: postgresql://username:password@db.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:your_strong_password@localhost:5432/movie_info"

# 2. 管理员后台密码 (请务必设置为高强度密码，例如 16 位以上混合字符)
ADMIN_PASSWORD="change_this_to_a_very_strong_password_in_production"

# 3. 会话签名加密盐值 (可选，用于对 Admin Cookie 进行 HMAC 防伪签名)
SESSION_SECRET="generate_a_random_32_char_hex_secret_here"

# 4. TMDB 官方 API Key (可选，申请地址: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""
